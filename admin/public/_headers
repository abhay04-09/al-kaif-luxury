# Headers Cloudflare Pages adds to every response from the admin panel.
#
# The panel had none beyond nosniff: it could be placed inside a frame on
# someone else's page, which is all a clickjack needs against whoever is
# signed in — and the session token lives in this origin's local storage.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://al-kaiff-api.adpatel8376.workers.dev; connect-src 'self' https://al-kaiff-api.adpatel8376.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
